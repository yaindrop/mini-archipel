{
  "name": "mini-archipel-console",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^26.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch src/server.ts",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "build": "pnpm i18n:check && vite build && esbuild src/server.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "check": "pnpm i18n:check && pnpm typecheck && pnpm lint && pnpm lint:ui && pnpm format:check && pnpm deadcode && pnpm test:coverage && pnpm build",
    "lint:ui": "biome lint src/web src/plugins",
    "test:agent": "node --test scripts/verify-agent.ts scripts/verify-operations.ts scripts/verify-fan-control.ts scripts/verify-runner-policy.ts scripts/verify-storage.ts",
    "check:agent": "cd ../agent && cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings && cargo test --locked && cargo build --release --locked && cd ../console && pnpm test:agent",
    "i18n:extract": "lingui extract --clean --workers 1",
    "i18n:check": "lingui check sync --workers 1 && lingui check missing --mode catalog --workers 1",
    "i18n:compile": "lingui compile --strict --workers 1",
    "audit": "node scripts/audit.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@lingui/core": "6.10.0",
    "@lingui/react": "6.10.0",
    "@tanstack/react-query": "5.104.4",
    "antd": "6.6.6",
    "fastify": "5.12.7",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "10.0.1",
    "@lingui/babel-plugin-lingui-macro": "6.10.0",
    "@lingui/cli": "6.10.0",
    "@lingui/conf": "6.10.0",
    "@lingui/format-po": "6.10.0",
    "@lingui/vite-plugin": "6.10.0",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-lingui": "0.16.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "knip": {
    "entry": [
      "lingui.config.ts",
      "scripts/verify-*.ts"
    ]
  }
}
