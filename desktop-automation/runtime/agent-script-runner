#!/usr/bin/env python3
"""Run a script inside the fixed Agent Script Runner macOS application."""
import argparse
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="mode", required=True)
    apple = commands.add_parser("run", help="Run an AppleScript source or compiled script")
    apple.add_argument("script")
    apple.add_argument("arguments", nargs=argparse.REMAINDER)
    command = commands.add_parser("exec", help="Execute a program with literal arguments")
    command.add_argument("program")
    command.add_argument("arguments", nargs=argparse.REMAINDER)
    commands.add_parser("authorize", help="Request Accessibility and System Events permission")
    args = parser.parse_args()
    app = Path.home() / "Agent Script Runner.app"
    if not app.is_dir():
        parser.error(f"Application not installed: {app}")
    request = {"mode": args.mode, "path": None, "arguments": [], "cwd": os.getcwd()}
    if args.mode == "run":
        path = Path(args.script).expanduser().resolve(strict=True)
        if not path.is_file() or path.suffix.lower() not in {".applescript", ".scpt"}:
            parser.error("run requires a .applescript or .scpt file")
        request.update(mode="applescript", path=str(path), arguments=args.arguments)
    elif args.mode == "exec":
        path = shutil.which(os.path.expanduser(args.program))
        if not path:
            parser.error(f"Executable not found: {args.program}")
        request.update(mode="command", path=str(Path(path).resolve()), arguments=args.arguments)
    with tempfile.TemporaryDirectory(prefix="agent-script-runner-") as temporary:
        directory = Path(temporary)
        request_file = directory / "request.json"
        request_file.write_text(json.dumps(request, ensure_ascii=False))
        os.chmod(request_file, 0o600)
        try:
            # LaunchServices establishes the App's identity; direct execution of
            # its Mach-O binary would retain the SSH caller's TCC attribution.
            launched = subprocess.run(
                ["/usr/bin/open", "-n", "-W", "-g", "-a", str(app),
                 "--args", "--request", str(request_file)],
                capture_output=True, text=True,
            )
        except KeyboardInterrupt:
            pid_file = directory / "pid"
            if pid_file.exists():
                try:
                    os.kill(int(pid_file.read_text()), signal.SIGTERM)
                except (ProcessLookupError, ValueError):
                    pass
            return 130
        result_file = directory / "result.json"
        if result_file.exists():
            result = json.loads(result_file.read_text())
        else:
            result = {"ok": False, "exit_code": 1,
                      "error": launched.stderr.strip() or "App exited without a result; confirm a desktop user is logged in"}
        print(json.dumps(result, ensure_ascii=False))
        status = int(result.get("exit_code", 1))
        return status if 0 <= status <= 125 else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(json.dumps({"ok": False, "exit_code": 1, "error": str(error)}, ensure_ascii=False))
        sys.exit(1)
